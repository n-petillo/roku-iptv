<?xml version="1.0" encoding="utf-8"?>
<!-- One-shot HTTP request. Set `request` = {kind, url, ctx}, then control = "RUN".
     Fills `content` (for list kinds) and then `result` = {kind, ctx, ok, error, data}. -->
<component name="ApiTask" extends="Task">
  <interface>
    <field id="request" type="assocarray" />
    <field id="content" type="node" />
    <field id="result" type="assocarray" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/ApiTask.brs" />
</component>
