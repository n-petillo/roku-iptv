<?xml version="1.0" encoding="utf-8"?>
<!-- Xtream providers (and their logo hosts) are usually plain http. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
